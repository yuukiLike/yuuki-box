{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node"],
    "rootDir": ".", "outDir": "dist", "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noEmitOnError": true, "sourceMap": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", ".artifacts"]
}
