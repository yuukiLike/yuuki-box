{
  "name": "yuuki-music-space-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "build": "tsc && esbuild web/main.ts --bundle --format=esm --target=es2022 --outfile=dist/viewer.js",
    "start": "node --enable-source-maps dist/src/stdio.js",
    "preview": "node --enable-source-maps dist/src/preview.js",
    "demo": "pnpm run build && node --enable-source-maps dist/src/demo.js",
    "test": "pnpm run build && node --enable-source-maps --test dist/tests/*.test.js",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@tonejs/midi": "2.0.28",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "esbuild": "0.28.1",
    "typescript": "6.0.3"
  }
}
