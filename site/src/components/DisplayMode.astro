---
interface Props {
  control?: 'focus' | 'directory';
}
const { control = 'focus' } = Astro.props;
---

{control === 'focus' && <script is:inline>
  // Read the preference before the directory and article are painted.
  (() => {
    let mode = 'lightweight';
    try {
      if (localStorage.getItem('yuuki-display-mode') === 'full') mode = 'full';
    } catch {
      // Storage is optional; the switch still works for this page.
    }
    document.documentElement.dataset.displayMode = mode;
  })();
</script>}

{control === 'directory' ? (
<button class="desktop-directory-toggle" type="button" aria-controls="starlight__sidebar" aria-expanded="false" aria-label="展开课程目录" title="展开课程目录" hidden>
  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="4" width="18" height="16" rx="2" />
    <path d="M9 4v16m4-11h4m-4 4h4" />
  </svg>
</button>
) : (
<button class="display-mode-toggle" type="button" aria-pressed="false" hidden>
  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20 4c0 9-4 14-10 14a6 6 0 0 1-6-6C4 6 11 4 20 4Z" />
    <path d="m4 21 10-11" />
  </svg>
  <span>专注阅读</span>
</button>
)}

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.display-mode-toggle');
  const directoryToggle = document.querySelector<HTMLButtonElement>('.desktop-directory-toggle');
  const sidebar = document.querySelector<HTMLElement>('#starlight__sidebar');
  const desktop = window.matchMedia('(min-width: 50rem)');

  function setDirectoryOpen(open: boolean) {
    document.documentElement.toggleAttribute('data-directory-open', open);
    if (!directoryToggle) return;
    const label = open ? '收起课程目录' : '展开课程目录';
    directoryToggle.setAttribute('aria-expanded', String(open));
    directoryToggle.setAttribute('aria-label', label);
    directoryToggle.title = label;
  }

  function resetDirectory() {
    setDirectoryOpen(false);
    if (directoryToggle) {
      directoryToggle.hidden = !desktop.matches || !sidebar;
    }
  }

  resetDirectory();

  if (toggle) {
    function renderMode(button: HTMLButtonElement) {
      const lightweight = document.documentElement.dataset.displayMode === 'lightweight';
      button.setAttribute('aria-pressed', String(lightweight));
      button.title = lightweight ? '退出专注阅读，显示章节详情与页内大纲' : '开启专注阅读，收起章节详情与页内大纲';
      document.querySelectorAll<HTMLDetailsElement>('.directory-chapters').forEach((chapters) => {
        chapters.open = !lightweight;
      });
    }

    renderMode(toggle);
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      // Close the mobile menu so its focus trap is released before hiding navigation.
      document.querySelector<HTMLElement>('#starlight__sidebar:popover-open')?.hidePopover();
      const mode = document.documentElement.dataset.displayMode === 'lightweight' ? 'full' : 'lightweight';
      document.documentElement.dataset.displayMode = mode;
      try {
        localStorage.setItem('yuuki-display-mode', mode);
      } catch {
        // A blocked storage area must not prevent changing the current view.
      }
      renderMode(toggle);
    });

    desktop.addEventListener('change', () => {
      const focusInSidebar = sidebar?.contains(document.activeElement) || document.activeElement === directoryToggle;
      resetDirectory();
      if (focusInSidebar) toggle.focus();
    });
  }

  if (directoryToggle && sidebar) {
    sidebar.querySelectorAll<HTMLElement>('summary').forEach((summary) => {
      summary.title = summary.textContent?.trim() ?? '';
    });
    directoryToggle.addEventListener('click', () => {
      const open = !document.documentElement.hasAttribute('data-directory-open');
      setDirectoryOpen(open);
      if (open) {
        const link = sidebar.querySelector<HTMLAnchorElement>('a[aria-current="page"]')
          ?? sidebar.querySelector<HTMLAnchorElement>('a');
        for (let group = link?.closest('details'); group; group = group.parentElement?.closest('details')) {
          group.open = true;
        }
        link?.focus({ preventScroll: true });
        link?.scrollIntoView({ block: 'nearest' });
      }
    });
    sidebar.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !document.documentElement.hasAttribute('data-directory-open')) return;
      event.preventDefault();
      setDirectoryOpen(false);
      directoryToggle.focus();
    });
  }
</script>

<style>
  .desktop-directory-toggle,
  .display-mode-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .35rem;
    flex-shrink: 0;
    min-height: 2rem;
    padding: .3rem .55rem;
    border: 1px solid transparent;
    border-radius: .5rem;
    color: var(--sl-color-gray-2);
    background: transparent;
    font: 500 .75rem/1.4 var(--sl-font);
    white-space: nowrap;
    cursor: pointer;
  }
  .desktop-directory-toggle[hidden],
  .display-mode-toggle[hidden] { display: none; }
  .desktop-directory-toggle {
    width: 2rem;
    padding: 0;
    color: var(--sl-color-gray-3);
  }
  .desktop-directory-toggle[aria-expanded='true'] { background: var(--yuuki-hover); }
  .display-mode-toggle[aria-pressed='true'] {
    color: var(--sl-color-gray-1);
    background: var(--yuuki-panel);
  }
  .desktop-directory-toggle:hover,
  .display-mode-toggle:hover { background: var(--yuuki-hover); }
</style>
