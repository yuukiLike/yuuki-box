---
import { learningStep, learningUrl } from '../lib/learning-guide.mjs';

interface Props { resume?: boolean; }
const { resume = false } = Astro.props;
const { entry } = Astro.locals.starlightRoute;
const id = entry.id;
const label = entry.data.title;
const step = learningStep(id);
---

{resume && <a class="learning-resume print:hidden" href="/" data-learning-resume data-page-id={id}
  title="继续阅读" aria-label="继续阅读" data-pagefind-ignore hidden>
  <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M3 11a9 9 0 1 1 2.6 7.4M3 4v7h7M12 7v5l3 2" />
  </svg>
</a>}

{!resume && step && <details class="learning-guide" data-learning-guide data-pagefind-ignore
  data-lesson-id={id} data-lesson-label={label}>
  <summary data-learning-summary>本章目标</summary>
  <dl>
    <div><dt>先做</dt><dd data-learning-first>{step.first}</dd></div>
    <div><dt>完成条件</dt><dd data-learning-stop>{step.stop}</dd></div>
  </dl>
  <div class="learning-actions">
    <a class="learning-start" href={learningUrl(id)} data-learning-start>开始</a>
    <button type="button" data-learning-done hidden>完成</button>
  </div>
  <p class="learning-storage" role="status" data-learning-storage hidden></p>
</details>}
{!resume && step && id.startsWith('labs/') && <span id="learning-step-start"></span>}

<script>
  import { learningUrl, learningFocusKey, parseLearningFocus, saveLearningFocus } from '../lib/learning-guide.mjs';

  const panel = document.querySelector<HTMLDetailsElement>('[data-learning-guide]');
  const resume = document.querySelector<HTMLAnchorElement>('[data-learning-resume]');
  let storage: Storage | null = null;
  let focus: ReturnType<typeof parseLearningFocus> = null;
  try {
    storage = window.localStorage;
    focus = parseLearningFocus(storage.getItem(learningFocusKey));
  } catch { storage = null; }

  function render() {
    if (resume) {
      resume.hidden = !focus || focus.done || focus.id === resume.dataset.pageId;
      if (focus) {
        resume.href = learningUrl(focus.id, focus.anchor);
        resume.title = `继续阅读：${focus.label}`;
        resume.setAttribute('aria-label', resume.title);
      }
    }
    if (!panel) return;
    const active = focus?.id === panel.dataset.lessonId;
    const finished = active && focus?.done;
    const start = panel.querySelector<HTMLAnchorElement>('[data-learning-start]')!;
    const done = panel.querySelector<HTMLButtonElement>('[data-learning-done]')!;
    const summary = panel.querySelector<HTMLElement>('[data-learning-summary]')!;
    start.href = learningUrl(panel.dataset.lessonId!, active ? focus?.anchor : undefined);
    start.textContent = finished ? '回看' : active ? '继续' : '开始';
    summary.textContent = finished ? '本章已完成' : active ? '当前任务' : '本章目标';
    done.hidden = !active || Boolean(finished);
  }

  function persist() {
    const saved = saveLearningFocus(storage, focus);
    const notice = panel?.querySelector<HTMLElement>('[data-learning-storage]');
    if (notice) {
      notice.hidden = saved;
      if (!saved) notice.textContent = '浏览器无法保存进度，本页仍可继续。';
    }
    return saved;
  }

  if (panel) {
    panel.querySelector('[data-learning-start]')!.addEventListener('click', () => {
      if (focus?.id !== panel.dataset.lessonId) {
        focus = { id: panel.dataset.lessonId!, label: panel.dataset.lessonLabel!, done: false };
        persist();
      }
      render();
    });
    panel.querySelector('[data-learning-done]')!.addEventListener('click', () => {
      if (!focus || focus.id !== panel.dataset.lessonId) return;
      focus = { ...focus, done: true };
      const saved = persist();
      render();
      panel.open = !saved;
      panel.querySelector<HTMLElement>('[data-learning-summary]')!.focus({ preventScroll: true });
    });
    window.addEventListener('pagehide', () => {
      if (!focus || focus.done || focus.id !== panel.dataset.lessonId) return;
      const headings = [...document.querySelectorAll<HTMLElement>('.sl-markdown-content :is(h2, h3)[id]')];
      const reached = headings.filter((heading) => heading.getClientRects().length
        && heading.getBoundingClientRect().top <= window.innerHeight * .35).at(-1);
      if (reached) saveLearningFocus(storage, { ...focus, anchor: reached.id });
    });
  }
  window.addEventListener('storage', (event) => {
    if (event.key !== learningFocusKey && event.key !== null) return;
    focus = event.key === null ? null : parseLearningFocus(event.newValue);
    render();
  });
  window.addEventListener('pageshow', () => {
    if (!storage) return;
    try {
      focus = parseLearningFocus(storage.getItem(learningFocusKey));
      render();
    } catch { storage = null; }
  });
  render();
</script>

<style>
  .learning-resume { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 2rem; height: 2rem; border-radius: .5rem; color: var(--sl-color-gray-3); text-decoration: none; }
  .learning-resume[hidden] { display: none; }
  .learning-resume:hover, .learning-resume:focus-visible { color: var(--sl-color-accent-high); background: var(--yuuki-hover); }
  .learning-guide { margin-top: .75rem; padding: .55rem .8rem; border: 1px solid var(--yuuki-border); border-radius: .5rem; background: transparent; }
  .learning-guide > summary { color: var(--sl-color-gray-3); font-size: .8rem; cursor: pointer; }
  .learning-guide[open] > summary { color: var(--sl-color-accent-high); }
  .learning-guide [hidden] { display: none !important; }
  .learning-guide p { margin: 0; }
  .learning-guide dl { display: grid; gap: .35rem; margin: .65rem 0 .8rem; font-size: .9rem; line-height: 1.65; }
  .learning-guide dl > div { display: grid; grid-template-columns: 4.8rem minmax(0, 1fr); gap: .35rem; }
  .learning-guide dt { color: var(--sl-color-gray-3); }
  .learning-guide dd { margin: 0; }
  .learning-actions { display: flex; flex-wrap: wrap; gap: .5rem; }
  .learning-actions :is(a, button) { display: inline-flex; padding: .4rem .7rem; border: 1px solid var(--yuuki-border); border-radius: .4rem; background: transparent; color: var(--sl-color-text); font: 500 .85rem/1.5 var(--sl-font); text-decoration: none; cursor: pointer; }
  .learning-actions .learning-start { background: var(--sl-color-accent-low); color: var(--sl-color-accent-high); border-color: var(--sl-color-accent-low); }
  .learning-actions :is(a, button):hover { border-color: var(--sl-color-accent); }
  .learning-storage { margin-top: .65rem !important; color: var(--sl-color-gray-3); font-size: .75rem; line-height: 1.6; }
  @media (max-width: 30rem) { .learning-guide dl > div { grid-template-columns: 1fr; gap: 0; } }
</style>
