---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DocumentDirectory from '../components/DocumentDirectory.astro';
---

<StarlightPage hasSidebar frontmatter={{
  title: '文档目录',
  description: '按想做成的事选择入口：AI 开发、Agent 工程、前端实验、语音、新玩法与架构研究。',
  tableOfContents: false,
  editUrl: false,
  prev: false,
  next: false,
}}>
  <div class="directory-home">
    <p class="directory-intro">
      <span class="lightweight-only">挑一件现在想做的事：修个 bug，拆开缓存，或听 Yuuki 说第一句话。展开章节就能找到第一步。</span>
      <span class="full-only">六条动手路线都在这里。带着一个具体问题出发，沿着案例、实验和源码往下挖。</span>
    </p>
    <DocumentDirectory />
  </div>
</StarlightPage>
