---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DocumentDirectory from '../components/DocumentDirectory.astro';
---

<StarlightPage hasSidebar frontmatter={{
  title: '文档目录',
  description: '从前端的数据结构与缓存开始，按章节阅读 KV Cache、WebAssembly 和 AI 应用。',
  tableOfContents: false,
  editUrl: false,
  prev: false,
  next: false,
}}>
  <div class="directory-home">
    <p class="directory-intro">
      <span class="lightweight-only">选一篇感兴趣的就好，想继续时再展开章节。</span>
      <span class="full-only">全部章节都在这里，也可以开启轻量模式慢慢看。</span>
    </p>
    <DocumentDirectory />
  </div>
</StarlightPage>
